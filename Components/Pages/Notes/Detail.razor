@page "/notes/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using _10xnotes.Data
@using _10xnotes.Data.Entities
@using _10xnotes.Notes
@using _10xnotes.Time
@inject UserScopedDbContextFactory DbContextFactory
@inject NoteService NoteService
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject ILogger<Detail> Logger

@* Interactive for the same reason the material page is: the editor is a live component, not a
   posted form. Data comes through UserScopedDbContextFactory and NoteService — injecting
   IDbContextFactory<> here fails DataAccessBoundaryTests and blocks the deploy.

   The note reaches this address two ways today: the redirect after accepting a draft, and the
   link on its material's page. A notes index is S-03. *@

<PageTitle>@(note?.Title ?? "Notatka")</PageTitle>

@if (note is null)
{
    @* A note that is not yours renders exactly like a note that does not exist. Telling the two
       apart would turn this page into a probe for which ids are real. *@
    <h1>Nie znaleziono notatki</h1>
    <p>Ta notatka nie istnieje albo nie należy do Twojego konta.</p>
    <a href="/materials/import">Dodaj nowy materiał</a>
}
else
{
    <h1>@note.Title</h1>

    <p class="text-secondary">
        @* ToDisplayTime, not ToLocalTime: "local" resolves against the container's clock, which
           is UTC. The culture is named explicitly so the month renders in Polish. *@
        Zapisano @TimeProvider.ToDisplayTime(note.UpdatedAt).ToString("d MMMM yyyy, HH:mm", PolishCulture).
    </p>

    @* The same two columns as the material page, and for the same PRD guardrail: the source stays
       available beside the note. Correcting a note without its material in front of you is
       exactly the thing the guardrail exists to prevent. *@
    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="h5">Materiał źródłowy</h2>

            @if (material is null)
            {
                <p class="text-secondary">Materiał źródłowy nie jest już dostępny.</p>
            }
            else
            {
                <p class="text-secondary">
                    <a href="/materials/@note.SourceMaterialId">@material.Title</a>
                </p>

                @* Raw text, never rendered as Markdown or markup — identical treatment to the
                   material page, so the source is provably unchanged wherever it is shown. *@
                <pre class="source-content border rounded p-3">@material.Content</pre>
            }
        </div>

        <div class="col-lg-6">
            <h2 class="h5">Notatka</h2>

            @if (savedMessage is not null)
            {
                <div class="alert alert-success" role="alert">@savedMessage</div>
            }

            @* No replace confirmation here, unlike the material page: this is the same note being
               corrected, not a fresh draft overwriting somebody's accepted work. No ledger event
               either — re-saving is not a new acceptance. *@
            <NoteEditor @bind-Title="editorTitle"
                        @bind-Content="editorContent"
                        SaveLabel="Zapisz zmiany"
                        IsBusy="@isSaving"
                        ErrorMessage="@saveErrorMessage"
                        OnSave="SaveAsync" />

            @* Below the editor and behind a rule, deliberately not beside "Zapisz zmiany": this
               is the only irreversible action on the page, so it should not sit where a mis-aimed
               click at the save button can land. *@
            <hr class="my-4" />

            <button type="button" class="btn btn-outline-danger"
                    disabled="@(isSaving || isDeleting)" @onclick="OpenDeleteDialog">
                Usuń notatkę
            </button>
        </div>
    </div>

    @if (isConfirmingDelete)
    {
        @* A modal dialog, and still not window.confirm — that one blocks the circuit's event
           loop, cannot be styled and cannot be written in Polish, which is why the material page
           rejected it too. Bootstrap ships the modal CSS but App.razor loads none of its JS, so
           the open/closed state is Blazor's rather than data-bs-toggle's, and the backdrop is
           rendered by hand. Placed outside the two-column row so it overlays the whole page. *@
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="delete-note-dialog-title"
             @onkeydown="OnDeleteDialogKeyDown">

            @* Focus sentinels rather than keystroke bookkeeping: shift-tabbing off the top lands
               on this span, whose focus handler sends focus to the last control, and the twin
               below closes the loop the other way. Tracking Tab by hand would need
               document.activeElement, which means custom JS this project's components do not
               have; a focus handler needs neither. Without the trap, Tab walks straight out of
               the dialog into the page behind — which is still there and still interactive —
               and aria-modal="true" above would be promising a modality nothing enforced. *@
            <span tabindex="0" class="visually-hidden" aria-hidden="true" @onfocus="FocusConfirmAsync"></span>

            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="delete-note-dialog-title">Usunąć notatkę?</h2>
                    </div>

                    <div class="modal-body">
                        @* The title is quoted back so the dialog names what is about to go, rather
                           than asking about "the note" while the page behind it is dimmed. Plain
                           interpolation, never MarkupString: the title comes from the user. *@
                        <p>
                            Usunięcie notatki „@note.Title” jest nieodwracalne.
                            Materiał źródłowy pozostanie nietknięty.
                        </p>

                        @if (deleteErrorMessage is not null)
                        {
                            @* Inside the dialog, because the dialog stays open when the delete
                               fails — an error behind the backdrop would be unreadable. *@
                            <div class="alert alert-danger mb-0" role="alert">@deleteErrorMessage</div>
                        }
                    </div>

                    <div class="modal-footer">
                        @* Cancel first, and the one that takes focus: the safe choice should be
                           where a reflexive Enter or click lands. *@
                        <button type="button" class="btn btn-outline-secondary"
                                @ref="cancelButton"
                                disabled="@isDeleting" @onclick="() => isConfirmingDelete = false">
                            Anuluj
                        </button>
                        <button type="button" class="btn btn-danger"
                                @ref="confirmButton"
                                disabled="@isDeleting" @onclick="DeleteAsync">
                            @(isDeleting ? "Usuwam…" : "Usuń notatkę")
                        </button>
                    </div>
                </div>
            </div>

            <span tabindex="0" class="visually-hidden" aria-hidden="true" @onfocus="FocusCancelAsync"></span>
        </div>

        <div class="modal-backdrop show"></div>
    }
}

@code {
    private static readonly CultureInfo PolishCulture = CultureInfo.GetCultureInfo("pl-PL");

    [Parameter]
    public Guid Id { get; set; }

    private Note? note;
    private SourceMaterial? material;

    private string editorTitle = string.Empty;
    private string editorContent = string.Empty;

    private bool isSaving;
    private string? saveErrorMessage;
    private string? savedMessage;

    /// <summary>
    /// Whether the delete dialog is showing.
    /// </summary>
    /// <remarks>
    /// A plain bool rather than the <c>Confirmation</c> enum the material page uses: that page has
    /// two mutually exclusive confirmations and has to say which one is pending, this one has a
    /// single question. Promote it to an enum if a second is ever added here.
    /// </remarks>
    private bool isConfirmingDelete;

    private bool isDeleting;
    private string? deleteErrorMessage;

    private ElementReference cancelButton;
    private ElementReference confirmButton;

    /// <summary>Set when the dialog opens, so the next render moves focus into it exactly once.</summary>
    private bool shouldFocusDeleteDialog;

    protected override async Task OnInitializedAsync()
    {
        // Owner-scoped by the global query filter, so somebody else's id simply finds nothing.
        note = await NoteService.GetAsync(Id);

        if (note is null)
        {
            return;
        }

        editorTitle = note.Title;
        editorContent = note.Content;

        await using var db = await DbContextFactory.CreateAsync();

        // A second query rather than a join: the project has no navigation properties, and the
        // material is owner-scoped in its own right, so this cannot reach across accounts.
        material = await db.SourceMaterials.FirstOrDefaultAsync(m => m.Id == note.SourceMaterialId);
    }

    private async Task SaveAsync()
    {
        if (note is null || isSaving)
        {
            return;
        }

        // Set before the first await: Blazor renders the moment this handler yields, so leaving
        // it until later hands the browser a render with the button still enabled.
        isSaving = true;
        saveErrorMessage = null;
        savedMessage = null;

        try
        {
            // UpdateAsync, never AcceptAsync. The difference is the whole point of this page: it
            // appends no acceptance event, because correcting a note is not a second acceptance.
            var result = await NoteService.UpdateAsync(Id, editorTitle, editorContent);

            if (!result.Succeeded)
            {
                saveErrorMessage = MessageFor(result.FailureReason);
                return;
            }

            // Stays on the page rather than navigating: the user is here to keep working on this
            // note, so the only thing that has to change is the confirmation that it landed.
            note = result.Note;

            savedMessage = "Zapisano zmiany o "
                + TimeProvider.ToDisplayTime(note!.UpdatedAt).ToString("HH:mm", PolishCulture)
                + ".";
        }
        catch (Exception exception)
        {
            // NoteService returns failures rather than throwing, so reaching this means something
            // outside its contract broke. Unhandled it would tear the circuit down and cost the
            // user the edits they were trying to keep.
            Logger.LogError(exception, "Saving note {NoteId} failed.", Id);
            saveErrorMessage = "Nie udało się zapisać notatki. Spróbuj ponownie za chwilę.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteDialog()
    {
        isConfirmingDelete = true;
        deleteErrorMessage = null;

        // Focus cannot move to an element that does not exist yet; OnAfterRenderAsync does it
        // once the dialog is actually in the DOM.
        shouldFocusDeleteDialog = true;
    }

    /// <remarks>
    /// Without this the dialog is a picture of a dialog: focus stays on the page behind the
    /// backdrop, so Escape never reaches the handler below and a keyboard user tabs through
    /// controls they cannot see. <c>FocusAsync</c> is a first-class Blazor API rather than custom
    /// interop, which matters in a project whose components hold no JS of their own.
    /// <para>
    /// Focus lands on <c>Anuluj</c> rather than on the dialog container, which is also what makes
    /// the sentinels wrap correctly: from the first control, Tab reaches the confirm button and
    /// then the closing sentinel, and Shift+Tab reaches the opening one. Keydown still bubbles
    /// from the button to the container, so Escape keeps working.
    /// </para>
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!shouldFocusDeleteDialog)
        {
            return;
        }

        // Cleared before the await, not after: this method runs again after the delete's own
        // renders, and a flag still set would fight the dialog for focus.
        shouldFocusDeleteDialog = false;

        await cancelButton.FocusAsync();
    }

    /// <summary>Sentinel handlers that wrap focus back into the dialog. See the sentinels' comment.</summary>
    private Task FocusCancelAsync() => cancelButton.FocusAsync().AsTask();

    private Task FocusConfirmAsync() => confirmButton.FocusAsync().AsTask();

    /// <summary>Escape cancels, which is what a dialog is expected to do.</summary>
    /// <remarks>
    /// Ignored while the delete is in flight: the request has already left, so closing the dialog
    /// would only hide what is happening.
    /// </remarks>
    private void OnDeleteDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !isDeleting)
        {
            isConfirmingDelete = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (note is null || isDeleting)
        {
            return;
        }

        // Captured before the delete, not after: the redirect target is derived from it, and the
        // note means nothing once its row is gone.
        var materialId = note.SourceMaterialId;

        // Set before the first await, for the same reason SaveAsync does it: Blazor renders the
        // moment this handler yields, so leaving it until later hands the browser a render with
        // the button still live.
        isDeleting = true;
        deleteErrorMessage = null;

        try
        {
            var deleted = await NoteService.DeleteAsync(Id);

            if (!deleted)
            {
                // Already gone, or never theirs. The user's intent — this note should not exist —
                // is satisfied either way, and telling the two cases apart on screen would turn
                // the page into a probe for which ids are real, which is exactly what
                // NoteSaveFailure.NotFound conflates them to avoid. The log line is what makes a
                // genuine bug that silently deletes nothing findable.
                Logger.LogInformation("Deleting note {NoteId} removed nothing; it was already gone.", Id);
            }

            // The material rather than the notes list: the likely reason to delete a note is to
            // generate a better one, and this is the page that does that. The flag is what makes
            // the deletion legible on arrival — without it the page is indistinguishable from a
            // material that never had a note.
            Navigation.NavigateTo($"/materials/{materialId}?noteDeleted=1");
        }
        catch (Exception exception)
        {
            // NoteService returns rather than throws, so reaching here means something outside its
            // contract broke. Unhandled it would tear the circuit down. The confirmation panel is
            // left open on purpose, with the error above it: the user can retry or cancel.
            Logger.LogError(exception, "Deleting note {NoteId} failed.", Id);
            deleteErrorMessage = "Nie udało się usunąć notatki. Spróbuj ponownie za chwilę.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string MessageFor(NoteSaveFailure failure) => failure switch
    {
        NoteSaveFailure.TitleEmpty =>
            "Podaj tytuł notatki.",
        NoteSaveFailure.TitleTooLong =>
            $"Tytuł może mieć najwyżej {NoteValidator.MaxTitleLength} znaków.",
        NoteSaveFailure.ContentEmpty =>
            "Notatka jest pusta — nie ma czego zapisać.",
        NoteSaveFailure.ContentTooLong =>
            $"Notatka może mieć najwyżej {NoteValidator.MaxContentLength / 1024} KB.",
        NoteSaveFailure.NotFound =>
            "Ta notatka już nie istnieje albo nie należy do Twojego konta.",
        // Conflict and anything added to the enum later. The default branch exists so a new member
        // cannot leave the user staring at an empty alert.
        _ =>
            "Nie udało się zapisać notatki. Spróbuj ponownie za chwilę."
    };
}
