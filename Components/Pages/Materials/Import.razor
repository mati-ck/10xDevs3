@page "/materials/import"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using _10xnotes.Data
@using _10xnotes.Data.Entities
@using _10xnotes.SourceMaterials
@inject UserScopedDbContextFactory DbContextFactory
@inject NavigationManager Navigation

@* Interactive on purpose, unlike the auth pages: InputFile's change event does not fire under
   static SSR in a Blazor Web App, so the file would never reach the server. Data still comes
   through UserScopedDbContextFactory — injecting IDbContextFactory<> here, which is what the
   Blazor docs reach for, fails DataAccessBoundaryTests and blocks the deploy. *@

@* The route stays /materials/import even though the page now does more than import. It is already
   in production; renaming it would break bookmarks and buy nothing. *@

<PageTitle>Dodaj materiał</PageTitle>

<div class="page-head">
    <div>
        <h1>Dodaj materiał</h1>
        <p class="sub">
            Wklej tekst albo wybierz plik Markdown (.md) — zapiszemy go na Twoim koncie
            i wygenerujesz z niego notatkę.
        </p>
    </div>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert"><Icon Name="IconName.Alert" /><span>@errorMessage</span></div>
}

<div class="card import-card">
    @* Same segmented switch NoteEditor uses for edit/preview, so the two toggles in the app look and
       behave alike. Paste is the default: it is the lower-effort entry point, which is the whole
       reason FR-003 exists beside FR-004. aria-pressed is written out as a string because Blazor
       drops a boolean attribute whose value is false. *@
    <div class="seg" role="group" aria-label="Sposób dodania materiału">
        <button type="button" class="seg-item @(mode == InputMode.Paste ? "on" : "")"
                aria-pressed="@(mode == InputMode.Paste ? "true" : "false")"
                @onclick="() => SelectMode(InputMode.Paste)">
            <Icon Name="IconName.Clipboard" Size="15" />
            Wklej tekst
        </button>
        <button type="button" class="seg-item @(mode == InputMode.File ? "on" : "")"
                aria-pressed="@(mode == InputMode.File ? "true" : "false")"
                @onclick="() => SelectMode(InputMode.File)">
            <Icon Name="IconName.File" Size="15" />
            Plik .md
        </button>
    </div>

    @* The form below keeps the indentation it had before the card wrapped it. The three #title lines
       must stay byte-identical to main: feature/test-plan rewrites the InputText line, and re-indenting
       its neighbours would turn the hook-check merge into a conflict (plan, "Import merge seam"). *@
<EditForm Model="Input" OnValidSubmit="SaveAsync" class="import-form">
    <DataAnnotationsValidator />

    @* Both panels stay in the DOM and the inactive one is hidden, rather than being rendered
       conditionally. Re-rendering the file input would reset what the browser shows as the chosen
       file even though the server still holds it, and a user who glanced at the other tab would be
       told they had picked nothing. Hiding costs one CSS class and keeps both entries intact. *@
    <div class="field @(mode == InputMode.Paste ? "" : "d-none")">
        <label for="paste" class="form-label">Tekst materiału</label>

        @* Committed on change rather than on input, exactly as NoteEditor's body is: every
           keystroke of a 128 K-character paste would otherwise be a SignalR round trip and a
           re-render. Blur fires change before the click that caused it, so switching tabs or
           hitting save always sees what was just pasted. *@
        @* maxlength is not cosmetic: the browser refusing the 131 073rd character is the
           difference between a validation message and a torn-down circuit, because the whole
           value crosses the wire in one hub invocation. HubWireLimits is the other half of that
           guarantee, and PasteValidator re-checks the length server-side because an attribute is
           a convenience, not a control. *@
        <textarea id="paste" class="form-control import-paste" rows="14"
                  maxlength="@PasteValidator.MaxContentLength"
                  value="@pasteContent" @onchange="OnPasteChanged" disabled="@isSaving"></textarea>

        <div class="form-text mono text-end">
            @* Characters, not kilobytes — the limit this counter counts up to is a character
               count, and showing KB here would promise a different unit than the one enforced. *@
            @pasteContent.Length.ToString("N0", PolishCulture) / @PasteValidator.MaxContentLength.ToString("N0", PolishCulture) znaków
        </div>
    </div>

    <div class="field @(mode == InputMode.File ? "" : "d-none")">
        <label for="file" class="form-label">Plik Markdown</label>

        @* The zone is pure CSS around the native input: the input is stretched transparently over it,
           so a click anywhere opens the picker and a dropped file lands in it without any JavaScript.
           It comes first and unconditionally — Blazor must never recreate it, or the browser would
           forget the chosen file, which is the same reason the panels are hidden and not removed. *@
        <div class="dropzone">
            <InputFile id="file" class="dropzone-input" accept=".md,.markdown" OnChange="OnFileSelected" />

            <div class="icon-tile icon-tile--lg"><Icon Name="IconName.Upload" Size="20" /></div>

            <div class="dropzone-text">
                <span class="dropzone-prompt">Upuść plik .md tutaj albo <span class="dropzone-link">wybierz z dysku</span></span>
                <div class="form-text">
                    Maksymalny rozmiar to @(MarkdownImportValidator.MaxFileSizeBytes / 1024) KB.
                </div>
            </div>

            @* The transparent input hides the browser's own "chosen file" label, so the page says it. *@
            @if (selectedFile is not null)
            {
                <span class="badge mono"><Icon Name="IconName.File" Size="13" /><span>@selectedFile.Name</span></span>
            }
        </div>
    </div>

    <div class="field">
        <label for="title" class="form-label">Tytuł</label>
        <InputText id="title" class="form-control" @bind-Value="Input.Title" />
        <div class="form-text">
            @(mode == InputMode.Paste
                ? "Uzupełniamy go z pierwszej linii tekstu — możesz poprawić przed zapisem."
                : "Uzupełniamy go z nazwy pliku — możesz poprawić przed zapisem.")
        </div>
        <ValidationMessage For="() => Input.Title" class="text-danger" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spin"></span>
            }
            @(isSaving ? "Zapisywanie…" : "Zapisz materiał")
        </button>
    </div>
</EditForm>
</div>

@code {
    // Same culture the material and note pages format their dates with, so the character counter
    // and the too-long message read as Polish numbers rather than as raw integers.
    private static readonly CultureInfo PolishCulture = CultureInfo.GetCultureInfo("pl-PL");

    /// <summary>Which of the two entry points the user is filling in.</summary>
    private enum InputMode
    {
        Paste,
        File
    }

    private ImportInput Input { get; set; } = new();

    private InputMode mode = InputMode.Paste;
    private string pasteContent = string.Empty;
    private IBrowserFile? selectedFile;
    private string? errorMessage;
    private bool isSaving;

    /// <summary>
    /// The last title this page filled in. A second file or a changed paste only overwrites the
    /// box when it still holds this value — otherwise it would silently discard whatever the user
    /// had typed. One field for both tabs: the box is shared, so the rule about it has to be too.
    /// </summary>
    private string autoFilledTitle = string.Empty;

    /// <summary>
    /// Switching tabs clears the error — it belongs to the entry the user just left — but keeps
    /// both the pasted text and the chosen file. Looking at the other option should not cost the
    /// user what they already put in.
    /// </summary>
    private void SelectMode(InputMode next)
    {
        mode = next;
        errorMessage = null;
    }

    private void OnPasteChanged(ChangeEventArgs e)
    {
        errorMessage = null;
        pasteContent = e.Value?.ToString() ?? string.Empty;

        SuggestTitle(PasteValidator.DeriveTitle(pasteContent));
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        selectedFile = e.File;

        SuggestTitle(MarkdownImportValidator.DeriveTitle(e.File.Name));
    }

    private void SuggestTitle(string suggestion)
    {
        if (Input.Title.Length == 0 || Input.Title == autoFilledTitle)
        {
            autoFilledTitle = suggestion;
            Input.Title = suggestion;
        }
    }

    /// <summary>
    /// One save path for both entries. Only the source of <c>Content</c>, the <c>Kind</c> and the
    /// file name differ — everything past that point (owner stamping, the failure posture, the
    /// redirect) is identical, and the detail page cannot tell the two apart.
    /// </summary>
    private async Task SaveAsync()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            var material = mode == InputMode.Paste
                ? BuildFromPaste()
                : await BuildFromFileAsync();

            if (material is null)
            {
                // errorMessage was set by whichever builder rejected the input.
                return;
            }

            try
            {
                // OwnerId is deliberately not set: AppDbContext stamps it from the signed-in user
                // and overwrites anything supplied, so ownership can never come from the request.
                await using var db = await DbContextFactory.CreateAsync();
                db.SourceMaterials.Add(material);
                await db.SaveChangesAsync();
            }
            catch (Exception ex) when (ex is DbUpdateException or InvalidOperationException)
            {
                // Left unhandled this escapes the event handler and tears the circuit down, so a
                // transient database blip costs the user their material and shows them a reconnect
                // modal instead of a reason. Same posture the auth pages take when Supabase is
                // unavailable.
                //
                // InvalidOperationException is here for a failure this page can actually produce:
                // AppDbContext.StampOwners throws it when the session has lapsed by the time the
                // user hits save. That is not a DbUpdateException, and letting it through would
                // cost a paste — which, unlike a chosen file, exists nowhere but in this circuit.
                errorMessage = "Nie udało się zapisać materiału. Spróbuj ponownie za chwilę.";
                return;
            }

            Navigation.NavigateTo($"/materials/{material.Id}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private SourceMaterial? BuildFromPaste()
    {
        var result = PasteValidator.Validate(pasteContent);

        if (!result.Succeeded)
        {
            errorMessage = MessageFor(result.FailureReason);
            return null;
        }

        return new SourceMaterial
        {
            Title = Input.Title.Trim(),
            Content = result.Content,
            Kind = SourceMaterialKind.Paste,

            // Empty rather than null, and the reason is rollback rather than modelling: the
            // column is nullable now, but the application version from before this slice maps it
            // as IsRequired(), and EF throws when it materialises a null into a required
            // property ("The data is NULL at ordinal N"). A Coolify rollback reverts the code and
            // not the migration, so a null written here would break the material page for the
            // version we roll back to. Kind is what says there is no file; this string carries no
            // meaning and must never become null. Pinned by
            // PasteValidatorTests.A_pasted_material_never_stores_a_null_file_name.
            OriginalFileName = string.Empty
        };
    }

    private async Task<SourceMaterial?> BuildFromFileAsync()
    {
        if (selectedFile is null)
        {
            errorMessage = "Wybierz plik do zaimportowania.";
            return null;
        }

        var content = await ReadAsync(selectedFile);

        if (content is null)
        {
            // OpenReadStream refused the file outright — see ReadAsync.
            errorMessage = MessageFor(MarkdownImportFailure.TooLarge);
            return null;
        }

        var result = MarkdownImportValidator.Validate(content, selectedFile.Name);

        if (!result.Succeeded)
        {
            errorMessage = MessageFor(result.FailureReason);
            return null;
        }

        return new SourceMaterial
        {
            Title = Input.Title.Trim(),
            Content = result.Content,
            Kind = SourceMaterialKind.MarkdownFile,
            OriginalFileName = MarkdownImportValidator.SanitizeFileName(selectedFile.Name)
        };
    }

    /// <summary>
    /// Reads the whole file into memory, or returns null when it is too large.
    /// </summary>
    /// <remarks>
    /// The bound is passed to <c>OpenReadStream</c> explicitly — its own default is 500 KB, and
    /// <c>IBrowserFile.Size</c> is supplied by the client, so neither can be relied on. The size
    /// pre-check exists only to fail fast; the stream bound is what actually holds, and it throws
    /// rather than truncating, so a client that lies about Size lands in the catch below instead
    /// of producing an unhandled exception.
    /// </remarks>
    private static async Task<byte[]?> ReadAsync(IBrowserFile file)
    {
        if (file.Size > MarkdownImportValidator.MaxFileSizeBytes)
        {
            return null;
        }

        try
        {
            await using var stream = file.OpenReadStream(MarkdownImportValidator.MaxFileSizeBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            return buffer.ToArray();
        }
        catch (IOException)
        {
            return null;
        }
    }

    private static string MessageFor(MarkdownImportFailure failure) => failure switch
    {
        MarkdownImportFailure.UnsupportedExtension =>
            "To nie jest plik Markdown. Wybierz plik z rozszerzeniem .md lub .markdown.",
        MarkdownImportFailure.TooLarge =>
            $"Plik jest za duży. Maksymalny rozmiar to {MarkdownImportValidator.MaxFileSizeBytes / 1024} KB.",
        MarkdownImportFailure.NotValidUtf8 =>
            "Nie udało się odczytać pliku jako tekstu. Zapisz go w kodowaniu UTF-8 i spróbuj ponownie.",
        MarkdownImportFailure.Empty =>
            "Plik jest pusty — nie ma z czego zrobić notatki.",
        _ =>
            "Nie udało się zaimportować pliku. Spróbuj ponownie."
    };

    /// <summary>
    /// The paste counterpart. Its limit is stated in characters, not KB, so the message and the
    /// counter under the textarea speak the same unit.
    /// </summary>
    private static string MessageFor(PasteFailure failure) => failure switch
    {
        PasteFailure.Empty =>
            "Wklejony tekst jest pusty — nie ma z czego zrobić notatki.",
        PasteFailure.TooLong =>
            $"Wklejony tekst jest za długi. Maksymalnie {PasteValidator.MaxContentLength.ToString("N0", PolishCulture)} znaków.",
        _ =>
            "Nie udało się zapisać wklejonego tekstu. Spróbuj ponownie."
    };

    private sealed class ImportInput
    {
        [Required(ErrorMessage = "Podaj tytuł materiału.")]
        [StringLength(200, ErrorMessage = "Tytuł może mieć najwyżej 200 znaków.")]
        public string Title { get; set; } = string.Empty;
    }
}
