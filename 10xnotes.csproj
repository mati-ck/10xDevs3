<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>_10xnotes</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <UserSecretsId>39f75e4c-7cbd-4666-b0d8-6a7e94640348</UserSecretsId>
    <!-- This project sits at the repo root, so its default globs would otherwise swallow the
         test project's sources. Keep tests/ out of the web app's compilation. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The vendor-neutral seam: components and services depend on IChatClient, never on a
         provider SDK. Microsoft.Extensions.AI.OpenAI pulls the OpenAI client transitively — do
         not reference it directly, or its version can drift from the one this package expects. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- Turns the note's Markdown into the structure the user is meant to judge, instead of the
         literal "##" and "-" the panel showed until now. Plain Markdig, not Markdig.Signed, and
         no separate HTML sanitizer: NoteMarkdown builds the pipeline with HTML parsing off and
         filters link schemes itself — see the remarks there for why both layers are needed. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

</Project>
