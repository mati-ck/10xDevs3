@using _10xnotes.Auth

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">10xnotes</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Moje notatki
                    </NavLink>
                </div>

                @* Match.All, not the default prefix match: "materials" is a prefix of both
                   /materials/import and /materials/{id}, so prefix matching would light this
                   entry up together with the import one. *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="materials" Match="NavLinkMatch.All">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Moje materiały
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="materials/import">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Dodaj materiał
                    </NavLink>
                </div>

                @* The display name when the user set one, the email otherwise. The rule is
                   AuthCookie's rather than this markup's so it is testable, and it reads a claim
                   rather than the database so the nav costs no query on any render. *@
                <div class="nav-item px-3 nav-user" title="@AuthCookie.DisplayNameOrEmail(context.User)">
                    @AuthCookie.DisplayNameOrEmail(context.User)
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profile">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Moje konto
                    </NavLink>
                </div>

                @* A link, not a form: signing out must be a POST carrying an antiforgery token,
                   and /logout is the static-SSR page that already owns exactly that form. *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="logout">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Wyloguj się
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Zaloguj się
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-person-plus-fill-nav-menu" aria-hidden="true"></span> Zarejestruj się
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
