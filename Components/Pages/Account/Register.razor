@page "/register"
@attribute [AllowAnonymous]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using _10xnotes.Auth
@inject SupabaseAuthClient AuthClient
@inject NavigationManager Navigation

@* Static SSR on purpose — see Login.razor. *@

<PageTitle>Rejestracja</PageTitle>

<div class="auth-head">
    <h1>Utwórz konto</h1>
    <p class="sub">Masz już konto? <a href="/login">Zaloguj się</a></p>
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert"><Icon Name="IconName.Alert" /><span>@errorMessage</span></div>
}

<EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="email" class="form-label">Adres e-mail</label>
        <div class="input-icon">
            <Icon Name="IconName.Mail" />
            <InputText id="email" class="form-control" @bind-Value="Input!.Email" autocomplete="username" />
        </div>
        <ValidationMessage For="() => Input!.Email" class="text-danger" />
    </div>

    <div class="field">
        <label for="password" class="form-label">Hasło</label>
        <div class="input-icon">
            <Icon Name="IconName.Lock" />
            <InputText id="password" type="password" class="form-control" @bind-Value="Input!.Password" autocomplete="new-password" />
        </div>
        <div class="form-text">@PasswordRequirementAttribute.Hint</div>
        <ValidationMessage For="() => Input!.Password" class="text-danger" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg w-100">Zarejestruj się<Icon Name="IconName.ArrowRight" StrokeWidth="2" /></button>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Not initialized inline: a form post can overwrite the property with null (BL0008).
    [SupplyParameterFromForm]
    private RegisterInput? Input { get; set; }

    private string? errorMessage;

    protected override void OnInitialized() => Input ??= new RegisterInput();

    private async Task RegisterAsync()
    {
        var result = await AuthClient.SignUpAsync(Input!.Email, Input.Password, HttpContext.RequestAborted);

        if (!result.Succeeded)
        {
            // Never confirm whether an address is already registered. The copy points at
            // recovery instead, so the user is not left without a next step.
            errorMessage = result.FailureReason switch
            {
                AuthFailureReason.Unavailable =>
                    "Usługa rejestracji jest chwilowo niedostępna. Spróbuj ponownie za chwilę.",
                AuthFailureReason.WeakPassword =>
                    $"Hasło jest zbyt słabe. Użyj co najmniej {PasswordLimits.MinLength} znaków.",
                _ =>
                    "Nie udało się utworzyć konta. Jeśli masz już konto, zaloguj się."
            };

            // See Login.razor: the password must not be echoed back in the form's value
            // attribute. The address stays.
            Input.Password = string.Empty;
            return;
        }

        // The profiles row is created by the on_auth_user_created trigger in Postgres.
        await AuthCookie.SignInAsync(HttpContext, result.UserId, result.Email);
        Navigation.NavigateTo("/");
    }

    private sealed class RegisterInput
    {
        [Required(ErrorMessage = "Podaj adres e-mail.")]
        [EmailAddress(ErrorMessage = "Podaj poprawny adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        // The bound is PasswordValidator's, not this form's: a StringLength(100) here once
        // advertised 28 characters more than GoTrue accepts, and anything in between came back
        // as "Nie udało się utworzyć konta" with nothing the user could act on.
        [PasswordRequirement]
        public string Password { get; set; } = string.Empty;
    }
}
