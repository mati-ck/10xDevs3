@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout

@* Anonymous for the same reason as Error.razor: UseStatusCodePagesWithReExecute restores the
   404 after re-execution, so a challenge here would produce a bodiless 404 rather than a
   redirect. The page reveals nothing beyond "this route does not exist". *@

<div class="card empty-state">
    <div class="icon-tile icon-tile--lg"><Icon Name="IconName.Alert" Size="24" /></div>

    <div>
        <h3>Not Found</h3>
        <p>Sorry, the content you are looking for does not exist.</p>
    </div>
</div>